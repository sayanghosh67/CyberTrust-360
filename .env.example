# ==============================================================================
# CyberTrust 360 - Environment Configuration Template
# Team TECHNIX PRO — AI-Powered Web Threat Detection & Digital Trust Intelligence
# ==============================================================================
# INSTRUCTIONS: Copy this file to .env and adjust variables as needed.
# NEVER commit your actual .env file to version control.

# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="CyberTrust 360"
TEAM_NAME="Technix Pro"
VERSION=0.2.0

# Backend Service
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cybertrust
POSTGRES_PASSWORD=cybertrust_secret_change_me_in_production
POSTGRES_DB=cybertrust_db
DATABASE_CONNECT_TIMEOUT=2

# Resilient SQLite Fallback (Auto-active when PostgreSQL container is offline)
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=./cybertrust.db

# Optional Direct Connection URL override (leave unset to use POSTGRES_* values)
# DATABASE_URL=postgresql://cybertrust:cybertrust_secret@localhost:5432/cybertrust_db

# ==============================================================================
# THREAT INTELLIGENCE PROVIDERS (PHASE 2)
# ==============================================================================
# Keep all API keys secret in this backend .env file.
# Never expose backend secrets to client-facing code.

# Google Safe Browsing API v4
# Obtain from: https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal API v3
# Obtain from: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# PhishTank API Key (Optional)
# Obtain from: https://phishtank.org/developer_info.php
PHISHTANK_API_KEY=

# URLhaus Open Intelligence Feed (Free, default: True)
URLHAUS_ENABLED=True

# ==============================================================================
# FRONTEND CONFIGURATION (Vite)
# ==============================================================================
# Only variables prefixed with VITE_ are exposed to the client bundle.
VITE_API_BASE_URL=http://localhost:8000
