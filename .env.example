# ==============================================================================
# CyberTrust 360 - Environment Configuration Template
# Team TECHNIX PRO — AI-Powered Web Threat Detection & Digital Trust Intelligence
# ==============================================================================
# INSTRUCTIONS: Copy this file to .env and adjust variables as needed.
# NEVER commit your actual .env file to version control.

# Application Environment
ENVIRONMENT=development
DEBUG=False
PROJECT_NAME="CyberTrust 360"
TEAM_NAME="Technix Pro"
VERSION=0.2.0

# Backend Service
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cybertrust
POSTGRES_PASSWORD=cybertrust_secret_change_me_in_production
POSTGRES_DB=cybertrust_db
DATABASE_CONNECT_TIMEOUT=2

# Resilient SQLite Fallback (Auto-active when PostgreSQL container is offline)
USE_SQLITE_FALLBACK=True
SQLITE_DB_PATH=./cybertrust.db

# Optional Direct Connection URL override (leave unset to use POSTGRES_* values)
# DATABASE_URL=postgresql://cybertrust:cybertrust_secret@localhost:5432/cybertrust_db

# ==============================================================================
# THREAT INTELLIGENCE PROVIDERS (PHASE 2)
# ==============================================================================
# Keep all API keys secret in this backend .env file.
# Never expose backend secrets to client-facing code.

# Google Safe Browsing API v4
# Obtain from: https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal API v3
# Obtain from: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# PhishTank API Key (Optional)
# Obtain from: https://phishtank.org/developer_info.php
PHISHTANK_API_KEY=

# URLhaus Open Intelligence Feed (Free, default: True)
URLHAUS_ENABLED=True

# ==============================================================================
# AI SCAM DNA & LLM INTELLIGENCE CONFIGURATION (PHASE 3)
# ==============================================================================
# Configurable LLM Provider: "gemini", "openai", or "auto"
LLM_PROVIDER=auto

# Google Gemini API Key
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (Alternative)
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Preferred model name (default: "gemini-1.5-flash" or "gpt-4o-mini")
LLM_MODEL_NAME=

# Scam message length guardrails (characters)
SCAM_MESSAGE_MIN_LENGTH=5
SCAM_MESSAGE_MAX_LENGTH=5000

# (If no LLM API key is provided, the platform automatically activates
# the transparent Deterministic Rule-Based Heuristic Engine with honest attribution)

# ==============================================================================
# BLOCKCHAIN THREAT REPORT INTEGRITY CONFIGURATION (PHASE 5)
# ==============================================================================
# Local EVM network configuration powered by Hardhat.
# WARNING: These are development/testnet credentials. Never use with real funds.
BLOCKCHAIN_ENABLED=True
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CHAIN_ID=31337
BLOCKCHAIN_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Standard Hardhat development private key for Account #0 (Local testnet ONLY)
BLOCKCHAIN_SIGNER_PRIVATE_KEY=
BLOCKCHAIN_TIMEOUT=10.0

# ==============================================================================
# FRONTEND CONFIGURATION (Vite)
# ==============================================================================
# Only variables prefixed with VITE_ are exposed to the client bundle.
VITE_API_BASE_URL=http://localhost:8000

# Required for manual API startup. Provision random tokens; never bundle them into frontend code.
API_AUTH_TOKENS={}
API_RATE_LIMIT=120
API_IP_RATE_LIMIT=240
API_MAX_BODY_BYTES=65536
# start_demo.sh creates a private local token and explicitly supplies its local Hardhat signer.

# Public website: private visitor sessions, no token-entry page.
VISITOR_SESSIONS_ENABLED=True
# Set a random >=32-character server-only secret for stable hosted sessions.
VISITOR_SESSION_SECRET=
# Never enable outside the supervised localhost demonstration.
LOCAL_DEMO_GUEST_SIGNING=False
