# ==============================================================================
# CyberTrust 360 - Environment Configuration Template
# Technix Pro Hackathon MVP
# ==============================================================================
# IMPORTANT: Copy this file to .env and adjust variables as needed.
# NEVER commit .env to source control.

# Application Settings
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="CyberTrust 360"
TEAM_NAME="Technix Pro"
VERSION=0.1.0

# Backend Service
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cybertrust
POSTGRES_PASSWORD=cybertrust_secret_change_me_in_production
POSTGRES_DB=cybertrust_db
DATABASE_CONNECT_TIMEOUT=3

# Optional Direct Connection URL override (leave unset to compose from POSTGRES_* values)
# DATABASE_URL=postgresql://cybertrust:cybertrust_secret_change_me_in_production@localhost:5432/cybertrust_db

# Frontend Settings (Used by Vite)
VITE_API_BASE_URL=http://localhost:8000
